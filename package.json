{
  "name": "forgebot",
  "version": "1.0.0",
  "description": "A modular, plugin-based Discord bot framework in Node.js",
  "main": "core/bot.js",
  "type": "module",
  "scripts": {
    "start": "node core/bot.js",
    "dev": "node --watch core/bot.js",
    "create-module": "node scripts/create-module.js",
    "validate-modules": "node scripts/validate-modules.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "plugin",
    "modular",
    "framework"
  ],
  "author": "ForgeBot Contributors",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "discord-player": "^6.7.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "libsodium-wrappers": "^0.7.13"
  },
  "devDependencies": {
    "eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}